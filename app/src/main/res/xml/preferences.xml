<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_general">
        <ListPreference
            app:key="language"
            app:title="@string/language"
            app:entries="@array/language_entries"
            app:entryValues="@array/language_values"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_permissions">
        <Preference app:key="perm_notif" app:title="@string/pref_notif" />
        <Preference app:key="perm_links" app:title="@string/pref_links"
            app:summary="@string/pref_links_summary" />
        <Preference app:key="perm_guard" app:title="@string/pref_guard" />
        <Preference app:key="perm_restricted" app:title="@string/gray_title"
            app:summary="@string/pref_restricted_summary" app:isPreferenceVisible="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_instagram">
        <ListPreference
            app:key="ig_feed"
            app:defaultValue="normal"
            app:title="@string/pref_feed"
            app:entries="@array/ig_feed_entries"
            app:entryValues="@array/ig_feed_values"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:key="ig_block_explore"
            app:defaultValue="true"
            app:title="@string/pref_explore"
            app:summary="@string/pref_explore_summary" />
        <SwitchPreferenceCompat
            app:key="ig_reels_in_limit"
            app:defaultValue="true"
            app:title="@string/pref_reels"
            app:summary="@string/pref_reels_summary" />
        <SwitchPreferenceCompat
            app:key="ig_tap_to_play"
            app:defaultValue="false"
            app:title="@string/pref_tap"
            app:summary="@string/pref_tap_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_comfort">
        <SwitchPreferenceCompat
            app:key="smooth_transitions"
            app:defaultValue="true"
            app:title="@string/pref_smooth"
            app:summary="@string/pref_smooth_summary" />
        <SwitchPreferenceCompat
            app:key="swipe_reply"
            app:defaultValue="true"
            app:title="@string/pref_swipe"
            app:summary="@string/pref_swipe_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/channel_sleep">
        <SwitchPreferenceCompat
            app:key="sleep_on"
            app:defaultValue="false"
            app:title="@string/pref_sleep_on"
            app:summary="@string/pref_sleep_on_summary" />
        <Preference app:key="sleep_all" app:title="@string/pref_schedule" app:dependency="sleep_on" />
        <SwitchPreferenceCompat
            app:key="sleep_per_day"
            app:defaultValue="false"
            app:title="@string/pref_per_day"
            app:dependency="sleep_on" />
        <Preference app:key="sleep_day_1" app:title="@string/pref_night_1"
            app:dependency="sleep_on" app:isPreferenceVisible="false" />
        <Preference app:key="sleep_day_2" app:title="@string/pref_night_2"
            app:dependency="sleep_on" app:isPreferenceVisible="false" />
        <Preference app:key="sleep_day_3" app:title="@string/pref_night_3"
            app:dependency="sleep_on" app:isPreferenceVisible="false" />
        <Preference app:key="sleep_day_4" app:title="@string/pref_night_4"
            app:dependency="sleep_on" app:isPreferenceVisible="false" />
        <Preference app:key="sleep_day_5" app:title="@string/pref_night_5"
            app:dependency="sleep_on" app:isPreferenceVisible="false" />
        <Preference app:key="sleep_day_6" app:title="@string/pref_night_6"
            app:dependency="sleep_on" app:isPreferenceVisible="false" />
        <Preference app:key="sleep_day_7" app:title="@string/pref_night_7"
            app:dependency="sleep_on" app:isPreferenceVisible="false" />
        <SwitchPreferenceCompat
            app:key="sleep_browsers"
            app:defaultValue="true"
            app:title="@string/pref_browsers"
            app:dependency="sleep_on" />
        <ListPreference
            app:key="sleep_warn"
            app:defaultValue="15"
            app:title="@string/pref_warn"
            app:entries="@array/sleep_warn_entries"
            app:entryValues="@array/sleep_warn_values"
            app:useSimpleSummaryProvider="true"
            app:dependency="sleep_on" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_focus">
        <SwitchPreferenceCompat
            app:key="focus_on"
            app:defaultValue="false"
            app:title="@string/pref_focus_on"
            app:summary="@string/pref_focus_on_summary" />
        <Preference app:key="focus_time" app:title="@string/pref_schedule" app:dependency="focus_on" />
        <MultiSelectListPreference
            app:key="focus_days"
            app:title="@string/pref_focus_days"
            app:entries="@array/weekday_entries"
            app:entryValues="@array/weekday_values"
            app:defaultValue="@array/weekday_default"
            app:dependency="focus_on" />
        <SwitchPreferenceCompat
            app:key="focus_youtube"
            app:defaultValue="true"
            app:title="@string/pref_focus_youtube"
            app:summary="@string/pref_focus_youtube_summary"
            app:dependency="focus_on" />
        <ListPreference
            app:key="session_warn"
            app:defaultValue="20"
            app:title="@string/pref_session"
            app:entries="@array/session_entries"
            app:entryValues="@array/session_values"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/channel_commitment">
        <ListPreference
            app:key="daily_limit"
            app:defaultValue="0"
            app:title="@string/pref_limit"
            app:summary="@string/pref_limit_summary"
            app:entries="@array/limit_entries"
            app:entryValues="@array/limit_values" />
        <Preference app:key="usage_today" app:title="@string/pref_usage_today" app:selectable="false" />
        <Preference app:key="commit" app:title="@string/commit_start" />
        <Preference
            app:key="pause_now"
            app:title="@string/pref_pause"
            app:isPreferenceVisible="false" />
        <Preference
            app:key="protect"
            app:title="@string/pref_protect"
            app:isPreferenceVisible="false" />
        <Preference app:key="usage_access" app:title="@string/pref_compare" />
        <Preference
            app:key="last_summary"
            app:title="@string/pref_last"
            app:isPreferenceVisible="false" />
        <Preference
            app:key="debug_end"
            app:title="@string/pref_debug_end"
            app:summary="@string/pref_debug_end_summary"
            app:isPreferenceVisible="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_bypass">
        <Preference app:key="bypass_now" app:title="@string/bypass_now" />
        <ListPreference
            app:key="bypass_minutes"
            app:defaultValue="10"
            app:title="@string/pref_bypass_minutes"
            app:summary="@string/pref_bypass_summary"
            app:entries="@array/bypass_entries"
            app:entryValues="@array/bypass_values" />
        <Preference
            app:key="bypass_tile"
            app:title="@string/pref_tile"
            app:summary="@string/pref_tile_summary"
            app:isPreferenceVisible="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_updates">
        <SwitchPreferenceCompat
            app:key="remote_rules"
            app:defaultValue="true"
            app:title="@string/pref_rules"
            app:summary="@string/pref_rules_summary" />
        <SwitchPreferenceCompat
            app:key="check_updates"
            app:defaultValue="true"
            app:title="@string/pref_updates" />
        <Preference app:key="check_now" app:title="@string/pref_check_now" />
        <Preference app:key="version" app:title="@string/pref_version" app:selectable="false" />
    </PreferenceCategory>
</PreferenceScreen>

<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Permisos">
        <Preference app:key="perm_notif" app:title="Redirigir notificaciones" />
        <Preference app:key="perm_links" app:title="Abrir links de Instagram/YouTube acá"
            app:summary="Agregá los dominios en 'Abrir de forma predeterminada'" />
        <Preference app:key="perm_guard" app:title="Bloquear apps oficiales" />
        <Preference app:key="perm_restricted" app:title="¿Un permiso aparece gris?"
            app:summary="Tocá acá para destrabarlo" app:isPreferenceVisible="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Instagram">
        <ListPreference
            app:key="ig_feed"
            app:defaultValue="normal"
            app:title="Feed de inicio"
            app:entries="@array/ig_feed_entries"
            app:entryValues="@array/ig_feed_values"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:key="ig_block_explore"
            app:defaultValue="true"
            app:title="Bloquear Explorar"
            app:summary="La búsqueda de usuarios sigue funcionando" />
        <SwitchPreferenceCompat
            app:key="ig_reels_in_limit"
            app:defaultValue="true"
            app:title="Reels dentro del límite diario"
            app:summary="Con un compromiso con límite, podés ver Reels hasta llegar al límite. De noche, no" />
        <SwitchPreferenceCompat
            app:key="ig_tap_to_play"
            app:defaultValue="false"
            app:title="Videos solo al tocar"
            app:summary="Ahorra datos: los videos no arrancan solos. Los reels que te mandan, sí" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Modo dormir">
        <SwitchPreferenceCompat
            app:key="sleep_on"
            app:defaultValue="false"
            app:title="Activar modo dormir"
            app:summary="En tu horario, Instagram queda solo para mensajes y YouTube se bloquea" />
        <Preference app:key="sleep_all" app:title="Horario" app:dependency="sleep_on" />
        <SwitchPreferenceCompat
            app:key="sleep_per_day"
            app:defaultValue="false"
            app:title="Horario distinto por día"
            app:dependency="sleep_on" />
        <Preference app:key="sleep_day_1" app:title="Noche de lunes a martes"
            app:dependency="sleep_on" app:isPreferenceVisible="false" />
        <Preference app:key="sleep_day_2" app:title="Noche de martes a miércoles"
            app:dependency="sleep_on" app:isPreferenceVisible="false" />
        <Preference app:key="sleep_day_3" app:title="Noche de miércoles a jueves"
            app:dependency="sleep_on" app:isPreferenceVisible="false" />
        <Preference app:key="sleep_day_4" app:title="Noche de jueves a viernes"
            app:dependency="sleep_on" app:isPreferenceVisible="false" />
        <Preference app:key="sleep_day_5" app:title="Noche de viernes a sábado"
            app:dependency="sleep_on" app:isPreferenceVisible="false" />
        <Preference app:key="sleep_day_6" app:title="Noche de sábado a domingo"
            app:dependency="sleep_on" app:isPreferenceVisible="false" />
        <Preference app:key="sleep_day_7" app:title="Noche de domingo a lunes"
            app:dependency="sleep_on" app:isPreferenceVisible="false" />
        <SwitchPreferenceCompat
            app:key="sleep_browsers"
            app:defaultValue="true"
            app:title="Bloquear navegadores"
            app:dependency="sleep_on" />
        <ListPreference
            app:key="sleep_warn"
            app:defaultValue="15"
            app:title="Aviso antes de empezar"
            app:entries="@array/sleep_warn_entries"
            app:entryValues="@array/sleep_warn_values"
            app:useSimpleSummaryProvider="true"
            app:dependency="sleep_on" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Compromiso">
        <ListPreference
            app:key="daily_limit"
            app:defaultValue="0"
            app:title="Límite diario (Instagram + YouTube)"
            app:summary="%s · corre durante el compromiso"
            app:entries="@array/limit_entries"
            app:entryValues="@array/limit_values" />
        <Preference app:key="usage_today" app:title="Uso de hoy" app:selectable="false" />
        <Preference app:key="commit" app:title="Empezar compromiso" />
        <Preference
            app:key="pause_now"
            app:title="Usar pausa de emergencia"
            app:isPreferenceVisible="false" />
        <Preference
            app:key="debug_end"
            app:title="Terminar compromiso (solo prueba)"
            app:summary="Aparece solo en los APK de prueba; en las versiones de Releases no está"
            app:isPreferenceVisible="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Pausa del bloqueo">
        <Preference app:key="bypass_now" app:title="Pausar ahora" />
        <ListPreference
            app:key="bypass_minutes"
            app:defaultValue="10"
            app:title="Duración de la pausa"
            app:summary="%s. No funciona en horario de dormir"
            app:entries="@array/bypass_entries"
            app:entryValues="@array/bypass_values" />
        <Preference
            app:key="bypass_tile"
            app:title="Agregar botón a ajustes rápidos"
            app:summary="Para pausar desde el panel que se abre deslizando desde arriba"
            app:isPreferenceVisible="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Actualizaciones">
        <SwitchPreferenceCompat
            app:key="remote_rules"
            app:defaultValue="true"
            app:title="Actualizar reglas de bloqueo"
            app:summary="Descarga arreglos desde GitHub sin reinstalar la app" />
        <SwitchPreferenceCompat
            app:key="check_updates"
            app:defaultValue="true"
            app:title="Avisar si hay versión nueva" />
        <Preference app:key="check_now" app:title="Buscar actualización ahora" />
        <Preference app:key="version" app:title="Versión" app:selectable="false" />
    </PreferenceCategory>
</PreferenceScreen>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget Hoy (2×2): arriba el dial del día y, al lado y en grande, lo usado hoy contra el límite; en
  el medio el estado; abajo los accesos a IG Lite y YT Lite. Si el widget es más chico, el dial
  se achica primero. Los textos y el dial los pone Widgets (estos son solo para la vista previa).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_ring"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:maxWidth="88dp"
            android:maxHeight="88dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ring_preview" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Se achica si no entra ("23 h 59 min", letra grande) -->
            <TextView
                android:id="@+id/w_number"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_minutes"
                android:textColor="@color/brand_text" />

            <TextView
                android:id="@+id/w_limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="@string/widget_preview_limit"
                android:textColor="@color/brand_text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_preview_status"
        android:textColor="@color/brand_text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_ig"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/label_ig"
            android:src="@mipmap/ic_ig" />

        <ImageView
            android:id="@+id/w_yt"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/label_yt"
            android:src="@mipmap/ic_yt" />
    </LinearLayout>
</LinearLayout>

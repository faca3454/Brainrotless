<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget Barra (4×1): el dial chico, lo usado contra el límite y el estado, y los accesos a IG Lite
  y YT Lite. Los textos y el dial los pone Widgets (estos son solo para la vista previa).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/w_ring"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ring_preview" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/widget_preview_amount"
            android:textColor="@color/brand_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_status"
            android:textColor="@color/brand_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_ig"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/label_ig"
        android:src="@mipmap/ic_ig" />

    <ImageView
        android:id="@+id/w_yt"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/label_yt"
        android:src="@mipmap/ic_yt" />
</LinearLayout>

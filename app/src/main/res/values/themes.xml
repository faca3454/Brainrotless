<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Sigue el modo claro/oscuro del sistema; Instagram y YouTube lo leen vía prefers-color-scheme -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorPrimary">@color/brand_primary</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:alertDialogTheme">@style/BrandDialog</item>
    </style>

    <!--
      Diálogos propios (AlertDialog): superficie y colores de la marca, esquinas de 28 dp y botones
      sin mayúsculas. En values-night la base es la oscura.
    -->
    <style name="BrandDialog" parent="BrandDialogBase">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">@color/brand_surface</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:textColorPrimary">@color/brand_text</item>
        <item name="android:textColorSecondary">@color/brand_text_muted</item>
        <item name="android:textColorAlertDialogListItem">@color/brand_text</item>
        <item name="android:buttonBarButtonStyle">@style/BrandDialogButton</item>
    </style>
    <style name="BrandDialogBase" parent="android:Theme.Material.Light.Dialog.Alert" />

    <style name="BrandDialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Pantallas propias de Lúcido (inicio, espera): fondo de la marca -->
    <style name="HomeTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/brand_bg</item>
        <item name="android:statusBarColor">@color/brand_bg</item>
        <item name="android:navigationBarColor">@color/brand_bg</item>
        <!-- Íconos de las barras oscuros en claro y claros en oscuro (sobre el fondo de la marca) -->
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_bars</item>
    </style>

    <!-- Pantallas de configuración (PanelActivity): AppCompat, para que los interruptores se dibujen -->
    <style name="PanelTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="colorControlActivated">@color/brand_primary</item>
        <item name="android:windowBackground">@color/brand_bg</item>
        <item name="android:statusBarColor">@color/brand_bg</item>
        <item name="android:navigationBarColor">@color/brand_bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_bars</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:alertDialogTheme">@style/BrandDialog</item>
    </style>

    <style name="SettingsTheme" parent="Theme.AppCompat.DayNight">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:windowBackground">@color/brand_bg</item>
        <item name="android:statusBarColor">@color/brand_bg</item>
        <item name="android:navigationBarColor">@color/brand_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="actionBarStyle">@style/BrandActionBar</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="BrandActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/brand_bg</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/BrandActionBarTitle</item>
    </style>

    <style name="BrandActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/brand_text</item>
    </style>
</resources>
